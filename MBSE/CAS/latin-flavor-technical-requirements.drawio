        <mxCell id="interface-rule-title" value="Interface rule | Monitor freely within permissions; qualify every control path" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=19;fontColor=#102C46;fontStyle=1;" vertex="1" parent="interface-rule">
          <mxGeometry x="16" y="15" width="1648" height="27.65" as="geometry" />
        </mxCell>
        <mxCell id="interface-rule-body" value="Solid blue: physical measurements. Solid red: local protection or manual safety actions. Dashed lines: supervisory data and recommendations. Cloud, dashboards and LLMs do not form the sole&#10;safety-control path. Candidate software names describe replaceable integrations, not an installed implementation." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="interface-rule">
