        <mxCell id="mode-2" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
