        <mxCell id="mode-2-title" value="Loss of cloud, power or sensors" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=19;fontColor=#B44036;fontStyle=1;" vertex="1" parent="mode-2">
          <mxGeometry x="16" y="15" width="498" height="27.65" as="geometry" />
        </mxCell>
        <mxCell id="mode-2-body" value="Demonstrate local alarm, protection and manual fallback.&#10;Loss of trustworthy telemetry must be visible; no inferred&#10;“safe” condition from missing data." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="mode-2">
