        <mxCell id="mode-3-title" value="Service and maintenance" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=19;fontColor=#665093;fontStyle=1;" vertex="1" parent="mode-3">
          <mxGeometry x="16" y="15" width="498" height="27.65" as="geometry" />
        </mxCell>
        <mxCell id="mode-3-body" value="Protect sanitation, temperature control and escape&#10;routes. Restrict control access, log interventions and&#10;isolate equipment for qualified maintenance." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="mode-3">
