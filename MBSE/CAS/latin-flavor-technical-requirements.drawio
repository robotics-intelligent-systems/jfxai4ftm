        <mxCell id="reqcard18-body" value="R19 Use documented replaceable&#10;interfaces.&#10;&#10;R20 Trace telemetry into OpenTwin&#10;assets.&#10;&#10;R21 Operate safely when cloud or AI&#10;fails." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="reqcard18">
