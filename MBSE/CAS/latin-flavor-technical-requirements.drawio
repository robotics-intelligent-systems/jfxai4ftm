        </mxCell>
        <mxCell id="mode-1-body" value="Confirm rated loads and stowed equipment before towing.&#10;Open service only after stable parking, checks and safe&#10;customer clearances. Fuel/cooking configuration remains&#10;an approved variant." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="mode-1">
