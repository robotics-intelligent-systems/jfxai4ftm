  <diagram id="sysml_vv_04" name="04 - SysML Traceability &amp; V&amp;V">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title4" value="Verification, Validation &amp; Traceability Matrix — SysML" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="v_box" value="&lt;b&gt;&amp;laquo;verificationMethod&amp;raquo; V-01 to V-06&lt;/b&gt;&lt;br&gt;&amp;bull; V-01 Inspection: Dimensions, access, stowage, labeling[cite: 1]&lt;br&gt;&amp;bull; V-02 Analysis: Mass budget, COG envelope, loads, thermal[cite: 1]&lt;br&gt;&amp;bull; V-03 Demonstration: Setup/stow sequence, workflow[cite: 1]&lt;br&gt;&amp;bull; V-04 Test: Electrical protection, temperature monitoring, telemetry[cite: 1]&lt;br&gt;&amp;bull; V-05 Road Validation: Controlled towing and deployment tests[cite: 1]&lt;br&gt;&amp;bull; V-06 Digital Verification: Twin state, timestamps, version traceability[cite: 1]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="230" y="140" width="1140" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="trace_rule" value="&lt;b&gt;SysML Traceability Rule&lt;/b&gt;&lt;br&gt;Stakeholder Need → System Requirement → Subsystem Requirement → Design Element → Verification Method → Evidence → Configuration Baseline[cite: 1]" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="230" y="480" width="1140" height="110" as="geometry"/>
