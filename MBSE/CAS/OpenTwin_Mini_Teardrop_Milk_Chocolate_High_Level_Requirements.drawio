<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="MVP Requirements Baseline &amp; Engineering Roadmap" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="mvp" value="&lt;b&gt;MVP BASELINE&lt;/b&gt;&lt;br&gt;• Compact teardrop chassis/body concept&lt;br&gt;• Tow/stabilization interfaces&lt;br&gt;• One deployable service hatch/counter&lt;br&gt;• Milk/chocolate dry + chilled storage concept&lt;br&gt;• Protected electrical distribution&lt;br&gt;• Task/service lighting&lt;br&gt;• Temperature + energy sensing&lt;br&gt;• Local OpenTwin gateway&lt;br&gt;• Configuration/history dashboard&lt;br&gt;• Manual safe setup/stow checklist" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="430" height="530" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Phase 1 — Requirements&lt;/b&gt;&lt;br&gt;Stakeholders&lt;br&gt;CONOPS&lt;br&gt;Requirements baseline&lt;br&gt;Hazard identification&lt;br&gt;Regulatory matrix" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="140" width="380" height="220" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Phase 2 — MBSE / CAD&lt;/b&gt;&lt;br&gt;Functional architecture&lt;br&gt;Interfaces&lt;br&gt;Mass/energy/thermal budgets&lt;br&gt;Packaging study&lt;br&gt;Digital mock-up" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="140" width="380" height="220" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Phase 3 — Prototype&lt;/b&gt;&lt;br&gt;Structural prototype&lt;br&gt;Electrical prototype&lt;br&gt;Service modules&lt;br&gt;OpenTwin edge integration" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="560" y="430" width="380" height="220" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b&gt;Phase 4 — Verification&lt;/b&gt;&lt;br&gt;Inspection&lt;br&gt;Bench tests&lt;br&gt;Thermal/electrical tests&lt;br&gt;Controlled towing/deployment&lt;br&gt;Traceability closure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1010" y="430" width="380" height="220" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Engineering Gate&lt;/b&gt;&lt;br&gt;Advance beyond concept only after mass, stability, structural, electrical, hygiene, operational and jurisdiction-specific requirements have been reviewed by appropriately qualified professionals." style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="430" y="760" width="980" height="120" as="geometry"/></mxCell><mxCell id="r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="p4" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
