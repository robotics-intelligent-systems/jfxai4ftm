<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-09T02:39:23.326700Z" agent="ChatGPT" version="24.7.17" type="device">
<diagram id="700e3eb39708" name="01 - Scope &amp; Stakeholders">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="OpenTwin Mini Teardrop Trailer — High-Level Requirements Engineering Specification" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="170" y="30" width="1260" height="70" as="geometry"/></mxCell><mxCell id="scopeh" value="1. System Scope" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="70" y="140" width="330" height="50" as="geometry"/></mxCell><mxCell id="scope" value="Concept: compact towable teardrop-format mobile kiosk / micro-retail trailer for milk, chocolate and related non-alcoholic products.&lt;br&gt;&lt;br&gt;Purpose: portable, modular, low-complexity commercial unit with OpenTwin digital representation for configuration, telemetry, maintenance and operations.&lt;br&gt;&lt;br&gt;Lifecycle: requirements → MBSE → CAD → prototype → verification → field pilot." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="205" width="330" height="300" as="geometry"/></mxCell><mxCell id="stakeh" value="2. Stakeholders" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="440" y="140" width="330" height="50" as="geometry"/></mxCell><mxCell id="stake" value="• Owner / operator&lt;br&gt;• Customer&lt;br&gt;• Food-service staff&lt;br&gt;• Vehicle / trailer engineer&lt;br&gt;• Electrical engineer&lt;br&gt;• Software / OpenTwin engineer&lt;br&gt;• Maintenance technician&lt;br&gt;• Local permitting / inspection authorities&lt;br&gt;• Tow-vehicle operator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="440" y="205" width="330" height="300" as="geometry"/></mxCell><mxCell id="goalh" value="3. System Goals" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="810" y="140" width="330" height="50" as="geometry"/></mxCell><mxCell id="goal" value="G-01 Portable operation&lt;br&gt;G-02 Safe towing and deployment&lt;br&gt;G-03 Hygienic product handling&lt;br&gt;G-04 Low-energy operation&lt;br&gt;G-05 Modular equipment bays&lt;br&gt;G-06 Rapid setup / teardown&lt;br&gt;G-07 Maintainability&lt;br&gt;G-08 Digital-twin observability&lt;br&gt;G-09 Open interfaces / replaceable components&lt;br&gt;G-10 Accessible customer service workflow" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="810" y="205" width="330" height="300" as="geometry"/></mxCell><mxCell id="boundh" value="4. System Boundary" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1180" y="140" width="330" height="50" as="geometry"/></mxCell><mxCell id="bound" value="IN SCOPE&lt;br&gt;Trailer structure, towing interface, service hatch, awning, storage, refrigeration/thermal management, potable-water subsystem where fitted, electrical power, lighting, POS interface, sensors, OpenTwin gateway.&lt;br&gt;&lt;br&gt;OUT OF SCOPE&lt;br&gt;Tow vehicle design, commercial food recipes, certified manufacturing drawings, jurisdiction-specific approval." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1180" y="205" width="330" height="300" as="geometry"/></mxCell><mxCell id="baseline" value="Baseline concept: single-axle compact teardrop trailer; deployable side/rear service area; milk/chocolate visual identity; optional solar-assisted low-voltage electrical system; configurable cold/dry storage; no dependency on proprietary cloud services." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="250" y="570" width="1100" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4541dab82b6f" name="02 - Functional Requirements">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Functional Requirements — OpenTwin Mini Teardrop Trailer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="FR-01" value="&lt;b&gt;FR-01 — Tow &amp; Transport&lt;/b&gt;&lt;br&gt;Trailer shall provide a road-towable interface compatible with the selected target vehicle and applicable local regulations." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-02" value="&lt;b&gt;FR-02 — Deploy&lt;/b&gt;&lt;br&gt;Operator shall be able to stabilize and deploy the kiosk configuration using defined setup procedures." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-03" value="&lt;b&gt;FR-03 — Service Interface&lt;/b&gt;&lt;br&gt;System shall provide a weather-protected customer service opening/counter." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-04" value="&lt;b&gt;FR-04 — Product Storage&lt;/b&gt;&lt;br&gt;System shall provide configurable storage for milk, chocolate, ingredients, packaging and utensils according to product requirements." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-05" value="&lt;b&gt;FR-05 — Thermal Control&lt;/b&gt;&lt;br&gt;Where chilled products are carried, the system shall monitor and maintain the configured storage temperature range." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-06" value="&lt;b&gt;FR-06 — Power&lt;/b&gt;&lt;br&gt;System shall distribute protected electrical power to approved loads and expose power state to the digital twin." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-07" value="&lt;b&gt;FR-07 — Water/Hygiene&lt;/b&gt;&lt;br&gt;Where water service is fitted, potable and waste-water circuits shall be physically separated and serviceable." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-08" value="&lt;b&gt;FR-08 — Lighting&lt;/b&gt;&lt;br&gt;System shall provide interior task lighting and exterior service lighting." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-09" value="&lt;b&gt;FR-09 — OpenTwin Telemetry&lt;/b&gt;&lt;br&gt;Gateway shall publish selected operational states such as temperature, energy, door/hatch state and maintenance indicators." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-10" value="&lt;b&gt;FR-10 — Configuration&lt;/b&gt;&lt;br&gt;Digital twin shall identify trailer configuration, installed modules, software versions and service history." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-11" value="&lt;b&gt;FR-11 — Offline Operation&lt;/b&gt;&lt;br&gt;Core kiosk functions shall remain usable when external network connectivity is unavailable." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="FR-12" value="&lt;b&gt;FR-12 — Shutdown&lt;/b&gt;&lt;br&gt;System shall support a defined safe shutdown, stowage and transport-ready sequence." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="99ff940d5693" name="03 - NFR &amp; Constraints">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Non-Functional Requirements &amp; Engineering Constraints" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="n0" value="&lt;b&gt;NFR-01 Safety&lt;/b&gt;&lt;br&gt;No sharp customer-accessible edges; deployable elements shall have secure stowed/deployed states." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;NFR-02 Structural&lt;/b&gt;&lt;br&gt;Chassis/body/load distribution shall be verified for the intended gross mass, towing envelope and road loads." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;NFR-03 Stability&lt;/b&gt;&lt;br&gt;Deployed trailer shall resist foreseeable service loads without unintended movement or tip-over." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="120" width="455" height="165" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;NFR-04 Hygiene&lt;/b&gt;&lt;br&gt;Food-contact and cleaning surfaces shall use suitable cleanable materials and layouts." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;NFR-05 Electrical&lt;/b&gt;&lt;br&gt;Electrical circuits shall include appropriate isolation, overcurrent protection, grounding/bonding strategy and environmental protection." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;NFR-06 Maintainability&lt;/b&gt;&lt;br&gt;Routine service items shall be accessible without destructive disassembly." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="325" width="455" height="165" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;NFR-07 Modularity&lt;/b&gt;&lt;br&gt;Refrigeration, power, water, POS and telemetry modules should use documented mechanical/electrical/data interfaces." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;NFR-08 Interoperability&lt;/b&gt;&lt;br&gt;OpenTwin integration should use documented, implementation-neutral APIs and common data formats." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;NFR-09 Cybersecurity&lt;/b&gt;&lt;br&gt;Remote interfaces shall use authentication, least privilege and protected credentials." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="530" width="455" height="165" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;NFR-10 Privacy&lt;/b&gt;&lt;br&gt;Telemetry shall avoid unnecessary personal/customer data; POS/payment data remains outside the OpenTwin core where practical." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="65" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;NFR-11 Availability&lt;/b&gt;&lt;br&gt;Loss of digital-twin connectivity shall not disable essential local operation." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="565" y="735" width="455" height="165" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;NFR-12 Sustainability&lt;/b&gt;&lt;br&gt;Design should favor repairable components, replaceable batteries/electronics, efficient appliances and recyclable materials." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1065" y="735" width="455" height="165" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8c818d960a45" name="04 - Architecture">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="High-Level System Architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="phys" value="&lt;b&gt;PHYSICAL TRAILER&lt;/b&gt;&lt;br&gt;Chassis &amp; shell&lt;br&gt;Tow coupling&lt;br&gt;Stabilizers&lt;br&gt;Service hatch / awning&lt;br&gt;Cabinetry &amp; counters" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="170" width="280" height="230" as="geometry"/></mxCell><mxCell id="food" value="&lt;b&gt;FOOD-SERVICE MODULES&lt;/b&gt;&lt;br&gt;Cold/dry storage&lt;br&gt;Milk/chocolate preparation equipment&lt;br&gt;Cleaning / water module&lt;br&gt;Packaging storage" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="410" y="170" width="280" height="230" as="geometry"/></mxCell><mxCell id="elec" value="&lt;b&gt;ENERGY &amp; CONTROL&lt;/b&gt;&lt;br&gt;Shore power&lt;br&gt;Optional solar&lt;br&gt;Battery / DC bus&lt;br&gt;Protection panel&lt;br&gt;Lighting / sensors" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="750" y="170" width="280" height="230" as="geometry"/></mxCell><mxCell id="edge" value="&lt;b&gt;OPENTWIN EDGE&lt;/b&gt;&lt;br&gt;Local gateway&lt;br&gt;Sensor adapters&lt;br&gt;Configuration registry&lt;br&gt;Local event buffer&lt;br&gt;Offline-first operation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1090" y="170" width="280" height="230" as="geometry"/></mxCell><mxCell id="twin" value="&lt;b&gt;OPENTWIN DIGITAL TWIN&lt;/b&gt;&lt;br&gt;Asset identity&lt;br&gt;Configuration&lt;br&gt;State/history&lt;br&gt;Energy/temperature telemetry&lt;br&gt;Maintenance records&lt;br&gt;Alerts / dashboards" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="1090" y="520" width="280" height="250" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;OPERATOR INTERFACE&lt;/b&gt;&lt;br&gt;Local status&lt;br&gt;Setup checklist&lt;br&gt;Temperature/energy status&lt;br&gt;Maintenance checklist&lt;br&gt;Optional POS link" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="750" y="520" width="280" height="250" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;EXTERNAL SYSTEMS&lt;/b&gt;&lt;br&gt;Tow vehicle&lt;br&gt;Electrical supply&lt;br&gt;Optional network&lt;br&gt;Approved payment service&lt;br&gt;Maintenance tools" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="410" y="520" width="280" height="250" as="geometry"/></mxCell><mxCell id="env" value="&lt;b&gt;OPERATING ENVIRONMENT&lt;/b&gt;&lt;br&gt;Road transport&lt;br&gt;Rural / urban sales site&lt;br&gt;Warm-weather operation&lt;br&gt;Rain / dust exposure&lt;br&gt;Public interaction" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="520" width="280" height="250" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="phys" target="food"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="food" target="elec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="elec" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="edge" target="twin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="twin" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="ext" target="ops"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" parent="1" edge="1" source="env" target="phys"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8371f0de0b2a" name="05 - Interfaces &amp; Twin Data">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Interfaces &amp; OpenTwin Data Model" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="i0" value="&lt;b&gt;IF-01 Mechanical&lt;/b&gt;&lt;br&gt;Tow coupling, safety attachment, jack/stabilizer points, wheel/axle, service-module mounts." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="130" width="690" height="165" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;IF-02 Electrical&lt;/b&gt;&lt;br&gt;Protected AC input where used; low-voltage DC distribution; appliance circuits; lighting; sensor power." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="130" width="690" height="165" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;IF-03 Thermal&lt;/b&gt;&lt;br&gt;Insulated storage boundaries, ventilation, heat rejection and temperature sensing." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="340" width="690" height="165" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;IF-04 Water&lt;/b&gt;&lt;br&gt;Optional potable fill, pump, sink, drain and waste tank interfaces; designed for cleaning/service." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="340" width="690" height="165" as="geometry"/></mxCell><mxCell id="i4" value="&lt;b&gt;IF-05 Data&lt;/b&gt;&lt;br&gt;Local sensor bus and IP interface; documented schemas; buffered events during network loss." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="550" width="690" height="165" as="geometry"/></mxCell><mxCell id="i5" value="&lt;b&gt;IF-06 Human&lt;/b&gt;&lt;br&gt;Service counter, operator controls, loading access, maintenance access and transport lockout." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="550" width="690" height="165" as="geometry"/></mxCell><mxCell id="schema" value="&lt;b&gt;OpenTwin minimum object&lt;/b&gt;&lt;br&gt;&lt;br&gt;asset_id&lt;br&gt;configuration_id&lt;br&gt;deployment_state&lt;br&gt;location (optional)&lt;br&gt;storage_temperature&lt;br&gt;energy_state&lt;br&gt;door_hatch_state&lt;br&gt;water_state (optional)&lt;br&gt;alerts[]&lt;br&gt;maintenance_due[]&lt;br&gt;software_version&lt;br&gt;timestamp / provenance" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="480" y="770" width="640" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="e467724059e4" name="06 - V&amp;V Traceability">
<mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Verification, Validation &amp; Requirements Traceability" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="180" y="25" width="1240" height="65" as="geometry"/></mxCell><mxCell id="v0" value="&lt;b&gt;V-01 Inspection&lt;/b&gt;&lt;br&gt;Dimensions, access, stowage, labeling, guards and cleanability." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="130" width="690" height="165" as="geometry"/></mxCell><mxCell id="v1" value="&lt;b&gt;V-02 Analysis&lt;/b&gt;&lt;br&gt;Mass budget, center-of-gravity envelope, structural loads, electrical load budget, thermal load." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="130" width="690" height="165" as="geometry"/></mxCell><mxCell id="v2" value="&lt;b&gt;V-03 Demonstration&lt;/b&gt;&lt;br&gt;Setup/stow sequence, customer-service workflow, offline operation and maintenance access." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="340" width="690" height="165" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b&gt;V-04 Test&lt;/b&gt;&lt;br&gt;Electrical protection, temperature monitoring, lighting, telemetry, alarms and selected environmental tests." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="340" width="690" height="165" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b&gt;V-05 Road/Prototype Validation&lt;/b&gt;&lt;br&gt;Controlled towing and deployment validation performed under applicable engineering and legal requirements." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="70" y="550" width="690" height="165" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;V-06 Digital Verification&lt;/b&gt;&lt;br&gt;Twin state, event timestamps, configuration/version traceability, connectivity-loss recovery and data integrity." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1"><mxGeometry x="830" y="550" width="690" height="165" as="geometry"/></mxCell><mxCell id="trace" value="&lt;b&gt;Traceability rule&lt;/b&gt;&lt;br&gt;Stakeholder Need → System Requirement → Subsystem Requirement → Design Element → Verification Method → Evidence → Configuration Baseline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="230" y="780" width="1140" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="a79d46d05862" name="07 - MVP &amp; Roadmap">
