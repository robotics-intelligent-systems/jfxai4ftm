 width="500" height="5" as="geometry" /></mxCell><mxCell id="operator-title" value="Operator and public service" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#397A5B;fontStyle=1;" vertex="1" parent="operator"><mxGeometry x="14" y="13" width="472" height="25" as="geometry" /></mxCell><mxCell id="operator-body" value="Transport → deploy → serve → secure&#10;Pre-service readiness checklist&#10;Accessible queue and serving interface&#10;Allergen and product information&#10;Manual mode and alarm escalation&#10;R01, R04, R08, R11, R16" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="operator"><mxGeometry x="14" y="41" width="472" height="168" as="geometry" /></mxCell><mxCell id="business" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="630" y="485" width="500" height="220" as="geometry" /></mxCell><mxCell id="business-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#946218;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="business"><mxGeometry x="0" y="0" width="500" height="5" as="geometry" /></mxCell><mxCell id="business-title" value="Business and fleet workflow" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#946218;fontStyle=1;" vertex="1" parent="business"><mxGeometry x="14" y="13" width="472" height="25" as="geometry" /></mxCell><mxCell id="business-body" value="Menu, POS and payments&#10;Inventory and lot traceability&#10;Location, route and shift planning&#10;Maintenance work orders&#10;Analytics with human approval&#10;R17–R21, R24" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="business"><mxGeometry x="14" y="41" width="472" height="168" as="geometry" /></mxCell><mxCell id="models" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1220" y="485" width="500" height="220" as="geometry" /></mxCell><mxCell id="models-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="models"><mxGeometry x="0" y="0" width="500" height="5" as="geometry" /></mxCell><mxCell id="models-title" value="MBSE, simulation and bounded AI" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="models"><mxGeometry x="14" y="13" width="472" height="25" as="geometry" /></mxCell><mxCell id="models-body" value="Thermal and cold-chain model&#10;Energy and battery scenarios&#10;Water and waste balance&#10;Demand and maintenance assistance&#10;Model-test correlation before claims&#10;AI cannot bypass protection&#10;R15, R21–R23" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="models"><mxGeometry x="14" y="41" width="472" height="168" as="geometry" /></mxCell><mxCell id="mode" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="530" height="178" as="geometry" /></mxCell><mxCell id="mode-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#176F9B;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="mode"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="mode-title" value="Deployment modes" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#176F9B;fontStyle=1;" vertex="1" parent="mode"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="mode-body" value="Transport: secured modules and rated loads.&#10;Service: stable parking, clear egress and hygiene checks.&#10;Maintenance: isolated equipment, controlled access and&#10;logged intervention." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="mode"><mxGeometry x="14" y="41" width="502" height="126" as="geometry" /></mxCell><mxCell id="boundary" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="615" y="790" width="530" height="178" as="geometry" /></mxCell><mxCell id="boundary-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#B44036;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="boundary"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="boundary-title" value="Control boundary" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#B44036;fontStyle=1;" vertex="1" parent="boundary"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="boundary-body" value="Local protection is authoritative for temperature alarms, BMS,&#10;emergency stop, leaks and any approved hot-service hazards.&#10;Supervisory software reports and recommends." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="boundary"><mxGeometry x="14" y="41" width="502" height="126" as="geometry" /></mxCell><mxCell id="interfaces" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1190" y="790" width="530" height="178" as="geometry" /></mxCell><mxCell id="interfaces-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#665093;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="interfaces"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="interfaces-title" value="Open integration rule" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#665093;fontStyle=1;" vertex="1" parent="interfaces"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="interfaces-body" value="Linux, OpenHAB, Node-RED, MQTT, Grafana and OpenTwin are&#10;candidate replaceable integrations. Each interface needs an&#10;ICD, permissions, units, version and replay test." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="interfaces"><mxGeometry x="14" y="41" width="502" height="126" as="geometry" /></mxCell><mxCell id="architecture-note" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1680" height="115" as="geometry" /></mxCell><mxCell id="architecture-note-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="architecture-note"><mxGeometry x="0" y="0" width="1680" height="5" as="geometry" /></mxCell><mxCell id="architecture-note-title" value="Failure behavior" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="architecture-note"><mxGeometry x="14" y="13" width="1652" height="25" as="geometry" /></mxCell><mxCell id="architecture-note-body" value="Cloud loss, AI loss, malformed telemetry or stale sensors shall produce an explicit degraded state. The truck shall not infer safety from silence and shall not grant an LLM authority over qualified&#10;interlocks." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="architecture-note"><mxGeometry x="14" y="41" width="1652" height="63" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="icecream-3" name="03 Materials"><mxGraphModel dx="1760" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1160" math="0" shadow="0" background="#F4F7FA"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1760" height="100" as="geometry" /></mxCell><mxCell id="title" value="OpenTwin | Ice Cream &amp; Desserts Truck" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=30;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1350" height="42" as="geometry" /></mxCell><mxCell id="subtitle" value="Material allocation and fire-risk controls | Qualify the installed assembly, not a material name" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#C8DCEB;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1370" height="24" as="geometry" /></mxCell><mxCell id="page-no" value="03 / MATERIALS" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=right;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="27" width="270" height="50" as="geometry" /></mxCell><mxCell id="footer" value="JFXAI4FTM • Proposed requirements baseline v0.1 • 12 Sep 2026 • Concept artwork is not a dimensioned engineering design" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526779;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1680" height="22" as="geometry" /></mxCell><mxCell id="cold-zone" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="530" height="140" as="geometry" /></mxCell><mxCell id="cold-zone-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#176F9B;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="cold-zone"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="cold-zone-title" value="COLD ZONE | body and decoration" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#176F9B;fontStyle=1;" vertex="1" parent="cold-zone"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="cold-zone-body" value="GFRP, aluminum and optional CFRP or synthetic finishes may&#10;be evaluated in protected areas. Maintain cleanability,&#10;insulation continuity and repair access." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="cold-zone"><mxGeometry x="14" y="41" width="502" height="88" as="geometry" /></mxCell><mxCell id="hot-zone" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFF9F7;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="615" y="130" width="530" height="140" as="geometry" /></mxCell><mxCell id="hot-zone-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#B44036;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="hot-zone"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="hot-zone-title" value="HOT-SERVICE OPTION | controlled change" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#B44036;fontStyle=1;" vertex="1" parent="hot-zone"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="hot-zone-body" value="Base variant: frozen service without open flame. Coffee, hot&#10;toppings or cooking adds separate exhaust, grease, detection,&#10;suppression, ventilation and clearance requirements." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="hot-zone"><mxGeometry x="14" y="41" width="502" height="88" as="geometry" /></mxCell><mxCell id="energy-zone" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1190" y="130" width="530" height="140" as="geometry" /></mxCell><mxCell id="energy-zone-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#946218;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="energy-zone"><mxGeometry x="0" y="0" width="530" height="5" as="geometry" /></mxCell><mxCell id="energy-zone-title" value="ENERGY ZONE | battery and charging" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#946218;fontStyle=1;" vertex="1" parent="energy-zone"><mxGeometry x="14" y="13" width="502" height="25" as="geometry" /></mxCell><mxCell id="energy-zone-body" value="Separate battery, inverter, chargers and high-current wiring&#10;from water, grease, packaging and public egress. Use local&#10;shutdown and fault monitoring." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="energy-zone"><mxGeometry x=