;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="720" y="305" width="530" height="44" as="geometry" /></mxCell><mxCell id="mht3" value="Engineering decision" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="316" width="510" height="25" as="geometry" /></mxCell><mxCell id="mh4" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=#FFFFFF;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1250" y="305" width="510" height="44" as="geometry" /></mxCell><mxCell id="mht4" value="Evidence before release" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="316" width="490" height="25" as="geometry" /></mxCell><mxCell id="m0-0" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="349" width="140" height="88" as="geometry" /></mxCell><mxCell id="mt0-0" value="M01" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="357" width="120" height="72" as="geometry" /></mxCell><mxCell id="m0-1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="180" y="349" width="240" height="88" as="geometry" /></mxCell><mxCell id="mt0-1" value="Acero naval" style=