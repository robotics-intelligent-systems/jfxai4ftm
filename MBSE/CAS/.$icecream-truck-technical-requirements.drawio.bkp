y reparación." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="357" width="490" height="72" as="geometry" /></mxCell><mxCell id="m1-0" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="437" width="140" height="88" as="geometry" /></mxCell><mxCell id="mt1-0" value="M02" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="445" width="120" height="72" as="geometry" /></mxCell><mxCell id="m1-1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="180" y="437" width="240" height="88" as="geometry" /></mxCell><mxCell id="mt1-1" value="Aluminio" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="190" y="445" width="220" height="72" as="geometry" /></mxCell><mxCell id="m1-2" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="420" y="437" width="300" height="88" as="geometry" /></mxCell><mxCell id="mt1-2" value="Bastidores, pieles y módulos de zona fría" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSiz