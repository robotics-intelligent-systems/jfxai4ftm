=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526779;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1680" height="22" as="geometry" /></mxCell><mxCell id="evidence" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="515" height="240" as="geometry" /></mxCell><mxCell id="evidence-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#176F9B;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="evidence"><mxGeometry x="0" y="0" width="515" height="5" as="geometry" /></mxCell><mxCell id="evidence-title" value="Concept evidence [S1–S2]" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#176F9B;fontStyle=1;" vertex="1" parent="evidence"><mxGeometry x="14" y="13" width="487" height="25" as="geometry" /></mxCell><mxCell id="evidence-body" value="Modular ice-cream and desserts truck with public serving&#10;hatch, frozen display and service counter.&#10;&#10;The artwork also suggests PV, battery, water, digital twin,&#10;real-time monitoring, predictive maintenance, resource&#10;optimization and open APIs." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="evidence" link="https://github.com/robotics-intelligent-systems/jfxai4ftm/blob/main/MBSE/CAD/icecream-truck-concept.jpg"><mxGeometry x="14" y="41" width="487" height="188" as="geometry" /></mxCell><mxCell id="system" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="585" y="125" width="635" height="240" as="geometry" /></mxCell><mxCell id="system-bar" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#102C46;strokeColor=none;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="system"><mxGeometry x="0" y="0" width="635" height="5" as="geometry" /></mxCell><mxCell id="system-title" value="REQ-SYS | Safe mobile cold-food service" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="system"><mxGeometry x="14" y="13" width="607" height="25" as="geometry" /></mxCell><mxCell id="system-body" value="Provide a road-ready, modular and maintainable service vehicle&#10;for frozen products and desserts. Preserve food safety, public&#10;accessibility, local emergency control, utility containment and an&#10;open supervisory data layer." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#203D52;fontStyle=0;" vertex="1" parent="system"><mxGeometry x="14" y="41" width="607" height="188" as="geometry" /></mxCell><mxCell id="concept" value="" style="shape=image;imageAspect=1;aspect=fixed;verticalAlign=top;image=data:image/jpeg;base64,;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4ftm/blob/main/MBSE/CAD/icecream-truck-concept.jpg"><mxGeometry x="1270" y="125" width="450" height="240" as="geometry" /></mxCell><mxCell id="caption" value="Reference image; dashboard values are illustrative." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=12;fontColor=#526779;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1