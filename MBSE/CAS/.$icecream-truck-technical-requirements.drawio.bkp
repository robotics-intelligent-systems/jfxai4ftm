ometry" /></mxCell><mxCell id="mt6-2" value="Paneles isotérmicos y pasos de&#10;instalaciones" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="885" width="280" height="72" as="geometry" /></mxCell><mxCell id="m6-3" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="720" y="877" width="530" height="88" as="geometry" /></mxCell><mxCell id="mt6-3" value="Seleccionar núcleo, adhesivo y sellos según temperatura, condensación y&#10;reacción al fuego. Controlar continuidad alrededor de puertas, vitrinas y&#10;batería." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="885" width="510" height="72" as="geometry" /></mxCell><mxCell id="m6-4" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1250" y="877" width="510" height="88" as="geometry" /></mxCell><mxCell id="mt6-4" value="Ensayo del panel completo y control de proceso." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="885" width="490" height="72" as="geometry" /></mxCell><mxCell id="assembly-rule" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeome