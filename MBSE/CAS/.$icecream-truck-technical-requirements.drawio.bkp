2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="533" width="120" height="72" as="geometry" /></mxCell><mxCell id="m2-1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="180" y="525" width="240" height="88" as="geometry" /></mxCell><mxCell id="mt2-1" value="Fibra de vidrio / GFRP" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="190" y="533" width="220" height="72" as="geometry" /></mxCell><mxCell id="m2-2" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="420" y="525" width="300" height="88" as="geometry" /></mxCell><mxCell id="mt2-2" value="Paneles exteriores protegidos" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="533" width="280" height="72" as="geometry" /></mxCell><mxCell id="m2-3" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="720" y="525" width="530" height="88" as="geometry" /></mxCell><mxCell id="mt2-3" value="Calificar fibra, resina, núcleo, adhesivo y acabado como laminado completo;&#10;la fibra de vidrio no hace incombustible a la matriz polimérica." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="533" width="510" height="72" as="geometry" /></mxCell><mxCell id="m2-4" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1250" y="525" width="510" height="88" as="geometry" /></mxCell><mxCell id="mt2-4" value="Dossier de material, fuego, humo, durabilidad y reparación." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="533" width="490" height="72" as="geometry" /></mxCell><mxCell id="m3-0" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="613" width="140" height="88" as="geometry" /></mxCell><mxCell id="mt3-0" value="M04" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="621" width="120" height="72" as="geometry" /></mxCell><mxCell id="m3-1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="180" y="613" width="240" height="88" as="geometry" /></mxCell><mxCell id="mt3-1" value="Fibra de carbono / CFRP" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="190" y="621" width="220" height="72" as="geometry" /></mxCell><mxCell id="m3-2" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="420" y="613" width="300" height="88" as="geometry" /></mxCell><mxCell id="mt3-2" value="Opción de reducción de masa" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="621" width="280" height="72" as="geometry" /></mxCell><mxCell id="m3-3" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="720" y="613" width="530" height="88" as="geometry" /></mxCell><mxCell id="mt3-3" value="Usar solo si el balance de masa lo justifica. Revisar daño, inspección,&#10;reparación, conductividad e interfaz con aluminio; excluir de zonas calientes&#10;no calificadas." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="621" width="510" height="72" as="geometry" /></mxCell><mxCell id="m3-4" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1250" y="613" width="510" height="88" as="geometry" /></mxCell><mxCell id="mt3-4" value="Trade-off, cupones de laminado, juntas y reparación." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="621" width="490" height="72" as="geometry" /></mxCell><mxCell id="m4-0" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="701" width="140" height="88" as="geometry" /></mxCell><mxCell id="mt4-0" value="M05" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="709" width="120" height="72" as="geometry" /></mxCell><mxCell id="m4-1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="180" y="701" width="240" height="88" as="geometry" /></mxCell><mxCell id="mt4-1" value="Madera sintética / WPC" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="190" y="709" width="220" height="72" as="geometry" /></mxCell><mxCell id="m4-2" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="420" y="701" width="300" height="88" as="geometry" /></mxCell><mxCell id="mt4-2" value="Acabados decorativos en zona fría" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="709" width="280" height="72" as="geometry" /></mxCell><mxCell id="m4-3" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="720" y="701" width="530" height="88" as="geometry" /></mxCell><mxCell id="mt4-3" value="Evaluar el producto real: puede contener matriz polimérica. No asumir&#10;clasificación por apariencia; alternativa conservadora: acabado símil madera&#10;metálico calificado." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="709" width="510" height="72" as="geometry" /></mxCell><mxCell id="m4-4" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#FFFFFF;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="1250" y="701" width="510" height="88" as="geometry" /></mxCell><mxCell id="mt4-4" value="Ensayo de acabado instalado, limpieza y envejecimiento." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1260" y="709" width="490" height="72" as="geometry" /></mxCell><mxCell id="m5-0" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="789" width="140" height="88" as="geometry" /></mxCell><mxCell id="mt5-0" value="M06" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="797" width="120" height="72" as="geometry" /></mxCell><mxCell id="m5-1" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="180" y="789" width="240" height="88" as="geometry" /></mxCell><mxCell id="mt5-1" value="Acero inoxidable + barrera&#10;mineral" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="190" y="797" width="220" height="72" as="geometry" /></mxCell><mxCell id="m5-2" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="420" y="789" width="300" height="88" as="geometry" /></mxCell><mxCell id="mt5-2" value="Interior, servicio y zona caliente" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="430" y="797" width="280" height="72" as="geometry" /></mxCell><mxCell id="m5-3" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3DFE7;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="720" y="789" width="530" height="88" as="geometry" /></mxCell><mxCell id="mt5-3" value="Candidato preferente para superficies lavables y resistentes. La barrera, el&#10;aislamiento, los adhesivos, las juntas y las penetraciones forman parte de la&#10;asamblea." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=13.2;fontColor=#203D52;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="730" y="797" width="510" height="72" as="geometry" /></mxCell><mxCell id="m5-4" value="" style="html=0;whiteSpace=wrap;overflow=hidden;rounded=0;arcSize=8;fillColor=#EBF1F6;strokeColor=#D3D