        <mxCell id="mode-title" value="Deployment modes" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#176F9B;fontStyle=1;" vertex="1" parent="mode">
