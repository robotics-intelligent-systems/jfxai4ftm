        <mxCell id="hot-zone-body" value="Base variant: frozen service without open flame. Coffee, hot&#xa;toppings or cooking adds separate exhaust, grease, detection,&#xa;suppression, ventilation and clearance requirements." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="hot-zone">
