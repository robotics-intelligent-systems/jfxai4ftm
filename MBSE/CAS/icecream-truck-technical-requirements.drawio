        <mxCell id="safety-body" value="Temperature sensing and alarms&#xa;BMS, overcurrent and ground-fault protection&#xa;Emergency disconnect and local reset&#xa;Leak / overflow and utility isolation&#xa;Optional hot-service variant review&#xa;Works without cloud or AI&#xa;R05–R16, R19" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="safety">
