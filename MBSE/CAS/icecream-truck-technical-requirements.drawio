          <mxGeometry x="0" y="0" width="1680" height="5" as="geometry" />
        </mxCell>
        <mxCell id="architecture-note-title" value="Failure behavior" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="architecture-note">
          <mxGeometry x="14" y="13" width="1652" height="25" as="geometry" />
        </mxCell>
        <mxCell id="architecture-note-body" value="Cloud loss, AI loss, malformed telemetry or stale sensors shall produce an explicit degraded state. The truck shall not infer safety from silence and shall not grant an LLM authority over qualified&#xa;interlocks." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="architecture-note">
          <mxGeometry x="14" y="41" width="1652" height="63" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
