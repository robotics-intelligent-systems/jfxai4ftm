        <mxCell id="models-body" value="Thermal and cold-chain model&#xa;Energy and battery scenarios&#xa;Water and waste balance&#xa;Demand and maintenance assistance&#xa;Model-test correlation before claims&#xa;AI cannot bypass protection&#xa;R15, R21–R23" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=17;fontColor=#203D52;fontStyle=0;" vertex="1" parent="models">
