        <mxCell id="boundary-title" value="Control boundary" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#B44036;fontStyle=1;" vertex="1" parent="boundary">
          <mxGeometry x="14" y="13" width="502" height="25" as="geometry" />
        </mxCell>
        <mxCell id="boundary-body" value="Local protection is authoritative for temperature alarms, BMS,&#xa;emergency stop, leaks and any approved hot-service hazards.&#xa;Supervisory software reports and recommends." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="boundary">
