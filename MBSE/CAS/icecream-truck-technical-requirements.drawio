        </mxCell>
        <mxCell id="interfaces-body" value="Linux, OpenHAB, Node-RED, MQTT, Grafana and OpenTwin are&#xa;candidate replaceable integrations. Each interface needs an&#xa;ICD, permissions, units, version and replay test." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="interfaces">
