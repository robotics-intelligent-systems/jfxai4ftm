        </mxCell>
        <mxCell id="mode-body" value="Transport: secured modules and rated loads.&#xa;Service: stable parking, clear egress and hygiene checks.&#xa;Maintenance: isolated equipment, controlled access and&#xa;logged intervention." style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#203D52;fontStyle=0;" vertex="1" parent="mode">
