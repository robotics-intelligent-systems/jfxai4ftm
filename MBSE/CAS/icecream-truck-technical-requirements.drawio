        <mxCell id="models-title" value="MBSE, simulation and bounded AI" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#102C46;fontStyle=1;" vertex="1" parent="models">
