        <mxCell id="interfaces-title" value="Open integration rule" style="html=0;whiteSpace=wrap;overflow=hidden;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontColor=#665093;fontStyle=1;" vertex="1" parent="interfaces">
